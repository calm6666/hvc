[Unit]
Description=HVC Video Transcoding Server
After=network.target mysql.service redis.service rabbitmq.service
Wants=mysql.service redis.service rabbitmq.service

[Service]
Type=simple
User=hvc
Group=hvc
ExecStart=/usr/local/bin/hvc-server --config /etc/hvc/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
LimitNPROC=4096

Environment=HOME=/var/lib/hvc
Environment=TMPDIR=/var/tmp/hvc

WorkingDirectory=/var/lib/hvc

ReadWritePaths=/var/tmp/hvc /var/log/hvc
ReadOnlyPaths=/etc/hvc

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hvc-server

[Install]
WantedBy=multi-user.target
