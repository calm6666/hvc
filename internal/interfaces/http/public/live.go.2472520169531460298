package public

import (
	"net/http"

	livesvc "hvc/internal/service/live"
	"hvc/internal/model"
	"hvc/pkg/logx"
)

// LiveHandler 处理直播接口。
type LiveHandler struct {
	service *livesvc.ChannelService
}

// NewLiveHandler 创建直播处理器。
func NewLiveHandler(service *livesvc.ChannelService) *LiveHandler {
	return &LiveHandler{service: service}
}

// GetPlaybackInfo 处理直播播放信息查询。
func (h *LiveHandler) GetPlaybackInfo(w http.ResponseWriter, r *http.Request) {
	channelKey := r.URL.Query().Get("channel_key")
	logx.Info("http.live.playback.request", logx.Fields{
		"channel_key": channelKey,
	})
	logx.WriteJSON(w, http.StatusOK, model.Response{
		Code:    0,
		Message: "ok",
		Data:    h.service.GetPlaybackInfoContext(r.Context(), channelKey),
	})
}
